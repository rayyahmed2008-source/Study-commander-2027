function renderTargets(){let d=document.getElementById('planDate').value||dateKey();let targets=currentTargets(new Date(d+'T12:00:00'));document.getElementById('dailyTargets').innerHTML=targets.map(t=>`<div class="entry"><span class="pill">${t.exam}</span> <span class="pill">${t.subject}</span> &nbsp; <b>${esc(t.chapter)}</b><div class="tiny">Main concept + examples + exam-level MCQs. Also mark status in syllabus tracker.</div></div>`).join('')}
