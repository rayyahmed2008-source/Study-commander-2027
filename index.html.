function toggleRev(id){let r=data.revisions.find(x=>x.id===id);r.done=!r.done;save()}function delRev(id){data.revisions=data.revisions.filter(x=>x.id!==id);save()}
function setMode(m){pauseTimer();timer.mode=m;let v=m==='focus'?'focusMin':m==='short'?'shortMin':'longMin';timer.remain=Math.max(1,Number(document.getElementById(v).value))*60;drawTimer()}
function drawTimer(){document.getElementById('clock').textContent=String(Math.floor(timer.remain/60)).padStart(2,'0')+':'+String(timer.remain%60).padStart(2,'0');document.getElementById('timerMode').textContent=timer.mode==='focus'?'Focus session':timer.mode==='short'?'Short break':'Long break';document.getElementById('timerBtn').textContent=timer.running?'Pause':'Start '+(timer.mode==='focus'?'focus':'break')}
function switchMode(m){setMode(m)}
function toggleTimer(){if(timer.running){pauseTimer();return}timer.running=true;timer.interval=setInterval(()=>{timer.remain--;if(timer.remain<=0){let was=timer.mode;pauseTimer();if(was==='focus'){data.sessions[dateKey()]=(data.sessions[dateKey()]||0)+Number(document.getElementById('focusMin').value);save();alert('Focus block complete. Take a break.');setMode('short')}else{alert('Break finished.');setMode('focus')}return}drawTimer()},1000);drawTimer()}
function pauseTimer(){if(timer.interval)clearInterval(timer.interval);timer.interval=null;timer.running=false;drawTimer()}
function resetTimer(){setMode(timer.mode)}
function chat(){let i=document.getElementById('chatInput'),q=i.value.trim();if(!q)return;let a='Choose one small target, study the concept, solve examples, attempt timed questions, and record errors. Use the syllabus tracker to mark progress.';let l=q.toLowerCase();if(l.includes('schedule')||l.includes('time'))a='After college: 4:30–6:30 Physics; 6:45–8:15 Chemistry; 8:45–10:15 Mathematics; 10:30–11:30 PYQs and revision. Breaks are built in. Protect your sleep and move a block if needed.';else if(l.includes('revision'))a='Use spaced revision: next day, 3 days, 7 days and 14 days. Start with active recall, then solve 10–20 questions and update your error log.';else if(l.includes('mock'))a='After each mock, classify mistakes: concept gap, calculation error, misread question or time issue. Pick the two biggest patterns and fix those before the next mock.';else if(l.includes('weak')||l.includes('start'))a='Start from prerequisites and build up. Do not try to finish a whole chapter in one sitting. Split it into concepts, examples, MCQs and a short recap.';document.getElementById('chatbox').innerHTML+=`<div class="bubble user">${esc(q)}</div><div class="bubble bot">${esc(a)}</div>`;i.value='';document.getElementById('chatbox').scrollTop=99999}
