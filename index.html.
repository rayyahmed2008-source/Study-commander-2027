function noteFor(ch){
 let exact=chapterNotes[ch.name];
 if(exact)return exact;
 let alias=Object.keys(chapterNotes).find(k=>ch.name.toLowerCase().includes(k.toLowerCase())||k.toLowerCase().includes(ch.name.toLowerCase()));
 if(alias)return chapterNotes[alias];
 let t=Object.keys(extraTopicMap).find(k=>ch.name.toLowerCase().includes(k.toLowerCase()));
 return {topics:extraTopicMap[t]||["Read the prescribed textbook section","List definitions, laws and key concepts","Study diagrams, graphs, reactions or derivations","Solve worked examples","Practise topic-wise objective questions","Review mistakes and revise key points"],formulas:ch.subject==="Physics"?[["Core relation","Write the governing law and define each symbol"],["SI units","Check dimensions and units before substitution"]]:ch.subject==="Mathematics"?[["Key identity","Write the chapter's standard identities and conditions"],["Method","Check domain, restrictions and special cases"]]:[["Key relation","Record important reaction conditions and exceptions"],["Units / quantities","Check definitions, units and assumptions"]]};
}
function renderLibrary(){
 const ex=document.getElementById('libExam').value,sub=document.getElementById('libSubject').value,q=document.getElementById('libSearch').value.toLowerCase();
 const arr=data.chapters.filter(c=>(ex==="All exams"||c.exam===ex)&&(sub==="All subjects"||c.subject===sub)&&(c.name.toLowerCase().includes(q)||noteFor(c).topics.some(t=>t.toLowerCase().includes(q))));
 document.getElementById('libCount').textContent=arr.length+" chapters · "+arr.reduce((n,c)=>n+noteFor(c).topics.length,0)+" listed topic checkpoints";
 document.getElementById('libraryList').innerHTML=arr.map(c=>{
  const d=noteFor(c),key=String(c.id),done=(data.topicDone&&data.topicDone[key])||[];
  return `<details class="chapter-card"><summary class="chapter-head"><div><b>${esc(c.name)}</b><div class="tiny">${esc(c.exam)} · ${esc(c.subject)} · ${done.length}/${d.topics.length} topics checked</div></div><span class="pill">${c.status}</span></summary><div class="chapter-detail"><h4>Topic checklist</h4><div class="topic-list">${d.topics.map((t,i)=>`<label class="topic-item"><input type="checkbox" ${done.includes(i)?"checked":""} onchange="toggleTopic(${c.id},${i},this.checked)"><span>${esc(t)}</span></label>`).join("")}</div><h4>Formula / equation sheet</h4><div class="formula-grid">${d.formulas.map(f=>`<div class="formula-card"><b>${esc(f[0])}</b><code>${esc(f[1])}</code></div>`).join("")}</div><div class="tiny" style="margin-top:10px">Use the chapter's own notes and textbook to add any teacher-specific results or exceptions.</div></div></details>`;
 }).join("")||'<div class="empty">No chapters match your search.</div>';
}
function toggleTopic(id,i,on){
 if(!data.topicDone)data.topicDone={};let a=data.topicDone[String(id)]||[];
 if(on&&!a.includes(i))a.push(i);if(!on)a=a.filter(x=>x!==i);data.topicDone[String(id)]=a;localStorage.setItem(KEY,JSON.stringify(data));
 const card=[...document.querySelectorAll('#libraryList details')].find(d=>d.querySelector('.chapter-head b')?.textContent===data.chapters.find(c=>c.id===id)?.name);
 if(card){let n=noteFor(data.chapters.find(c=>c.id===id));card.querySelector('.tiny').textContent=`${data.chapters.find(c=>c.id===id).exam} · ${data.chapters.find(c=>c.id===id).subject} · ${a.length}/${n.topics.length} topics checked`;}
}
