/* Mobile-first Study Commander refresh */
:root{--bg:#080d18;--panel:#101a2b;--panel2:#17243a;--line:#263853;--txt:#f1f6ff;--muted:#a5b4cb;--blue:#9ab4ff;--cyan:#68e2d5}
body{background:linear-gradient(180deg,#101d32 0,#080d18 360px);font-size:15px}
.app{max-width:1280px;padding:clamp(10px,2.2vw,22px)}
.side,.panel,.stat{border-radius:18px;box-shadow:0 8px 28px #00000018}
.side{backdrop-filter:blur(14px)}
.nav button{border-radius:12px;min-height:42px}
.nav button.active{background:#263b5b;border-color:#46638d}
button,input,select,textarea{min-height:42px}
button{touch-action:manipulation}
.panel{padding:clamp(13px,2vw,19px)}
.library-controls{display:grid;grid-template-columns:1fr 1fr 1.3fr;gap:10px}
.chapter-card{border:1px solid var(--line);background:#0d1728;border-radius:14px;margin:9px 0;overflow:hidden}
.chapter-head{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:13px;cursor:pointer}
.chapter-head b{font-size:14px}
.chapter-detail{padding:0 13px 14px;border-top:1px solid var(--line)}
.topic-list{display:grid;grid-template-columns:1fr 1fr;gap:7px;margin:12px 0}
.topic-item{display:flex;gap:8px;align-items:flex-start;background:#15233a;border-radius:10px;padding:9px;font-size:12px}
.topic-item input{width:17px;min-width:17px;height:17px;min-height:17px;accent-color:var(--cyan)}
.formula-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}
.formula-card{background:#14243b;border:1px solid #2c4262;border-radius:11px;padding:10px;min-width:0}
.formula-card code{font-size:13px;color:#d9e8ff;white-space:normal;overflow-wrap:anywhere}
.formula-card small{display:block;color:var(--muted);margin-top:4px}
.q-option{display:flex;gap:9px;align-items:flex-start;padding:12px;margin:8px 0;background:#14233a;border:1px solid var(--line);border-radius:12px;cursor:pointer}
.q-option.selected{border-color:var(--cyan);background:#173b42}
.q-option input{width:18px;min-width:18px;min-height:18px;height:18px}
.test-clock{font-size:20px;font-weight:800;font-variant-numeric:tabular-nums;color:var(--cyan)}
.answer-review{border-top:1px solid var(--line);padding:10px 0}
@media(max-width:760px){
 .app{padding:9px 9px 20px}
 .top{align-items:flex-start;margin-bottom:12px}
 .logo{width:39px;height:39px}
 .brand{gap:9px}
 .brand h1{font-size:16px}
 .brand p{font-size:10px;max-width:220px}
 .date{font-size:10px;max-width:90px}
 .layout{display:block}
 .side{position:sticky;top:0;z-index:40;margin:0 -9px 12px;border-radius:0 0 15px 15px;padding:6px 8px;background:#0c1627f2;border-left:0;border-right:0}
 .nav{display:flex;flex-direction:row;overflow-x:auto;gap:5px;scrollbar-width:none}
 .nav::-webkit-scrollbar{display:none}
 .nav button{flex:0 0 auto;white-space:nowrap;min-height:38px;padding:7px 10px;font-size:11px}
 .nav small{display:none}
 .heading{align-items:flex-start;margin:5px 0 12px}
 .heading h2{font-size:20px}
 .sub{font-size:12px}
 .stats{grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}
 .stat{padding:11px}
 .stat strong{font-size:21px}
 .grid.two,.grid.three{grid-template-columns:1fr}
 .panel{margin-bottom:10px}
 .library-controls{grid-template-columns:1fr 1fr}
 .library-controls .field:last-child{grid-column:1/-1}
 .topic-list,.formula-grid{grid-template-columns:1fr}
 .scheduleblock{grid-template-columns:82px minmax(0,1fr);gap:8px}
 .scheduleblock .pill{grid-column:2;justify-self:start}
 .tablewrap{margin:0 -5px}
 .clock{font-size:44px}
 .chatrow{flex-wrap:wrap}
 .chatrow input{min-width:0}
 .actions button{flex:1 1 auto}
}
@media(min-width:761px) and (max-width:1000px){
 .layout{grid-template-columns:170px minmax(0,1fr);gap:10px}
 .nav button{font-size:12px;padding:8px}
 .library-controls{grid-template-columns:1fr 1fr}
 .library-controls .field:last-child{grid-column:1/-1}
}

</style></head><body><div class="app">
<header class="top"><div class="brand"><div class="logo">SC</div><div><h1>Study Commander 2027</h1><p>JEE Main · TG EAPCET Engineering · Personal preparation planner</p></div></div><div class="date" id="dateNow"></div></header>
<div class="layout"><aside class="side"><nav class="nav">
<button class="active" data-view="home">▦ &nbsp; Dashboard</button><button data-view="plan">◷ &nbsp; Precise schedule</button><button data-view="syllabus">☷ &nbsp; Syllabus</button><button data-view="library">📚 &nbsp; Topics + formulas</button><button data-view="practice">✎ &nbsp; Practice tests</button><button data-view="weekly">▥ &nbsp; Weekly tracker</button><button data-view="mocks">◎ &nbsp; Mock tests</button><button data-view="timer">◴ &nbsp; Focus timer</button><button data-view="revision">↻ &nbsp; Revision queue</button><button data-view="tutor">✦ &nbsp; Study assistant</button><button data-view="resources">▣ &nbsp; Resources</button><small>Workspace</small><button data-view="settings">⚙ &nbsp; Backup & settings</button></nav></aside>
<main class="content">
<section class="view active" id="home"><div class="heading"><div><h2>Good study day starts here</h2><div class="sub">A structured plan around your 9 AM–4 PM college schedule.</div></div><span class="pill green">2027 preparation</span></div>
<div class="grid stats"><div class="stat"><small>Overall syllabus</small><strong id="sylPct">0%</strong><em>Completed chapters</em></div><div class="stat"><small>Study time today</small><strong id="todayHours">0m</strong><em>Timer-recorded time</em></div><div class="stat"><small>Today's tasks</small><strong id="taskPct">0/0</strong><em>Daily checklist</em></div><div class="stat"><small>Mock average</small><strong id="mockAvg">—</strong><em>Recorded tests</em></div></div>
<div class="grid two"><div class="panel"><div class="row"><h3>Today's study blocks</h3><button onclick="go('plan')">View schedule ↗</button></div><div id="homeTasks"></div></div><div class="panel"><h3>Subject completion</h3><div id="subjectBars"></div></div></div>
<div class="panel"><h3>Today's alternating exam targets</h3><div id="chapterTargets"></div><div class="tiny">Targets rotate through the syllabus. If a chapter is unfinished, keep it as the next day's priority rather than rushing ahead.</div></div>
<div class="panel"><h3>Next revision due</h3><div id="nextRevision"></div></div></section>
<section class="view" id="plan"><div class="heading"><div><h2>Precise daily schedule</h2><div class="sub">Six focused study hours after college, with breaks and meal time.</div></div><span class="pill">Mon–Sun template</span></div>
<div class="notice">This is a demanding target. Protect sleep (aim for 8–10 hours), take breaks, and reduce the workload on days when college or health is demanding. Chapter targets alternate by date: JEE Main one day, TG EAPCET the next. Consistency matters more than completing every block.</div>
<div class="panel"><h3>Weekday timetable</h3><div class="scheduleblock"><b>4:30–6:30</b><div><b>Physics — 2 hours</b><div class="tiny">Concept lesson 50m · worked examples 30m · MCQs 30m · error log 10m</div></div><span class="pill">120 min</span></div>
<div class="scheduleblock"><b>6:30–6:45</b><div><b>Break</b><div class="tiny">Move around, hydrate, rest your eyes.</div></div><span class="pill">15 min</span></div>
<div class="scheduleblock"><b>6:45–8:15</b><div><b>Chemistry — 90 minutes</b><div class="tiny">Concepts / NCERT 40m · examples 20m · MCQs 25m · recap 5m</div></div><span class="pill">90 min</span></div>
<div class="scheduleblock"><b>8:15–8:45</b><div><b>Dinner break</b><div class="tiny">Take a proper break.</div></div><span class="pill">30 min</span></div>
<div class="scheduleblock"><b>8:45–10:15</b><div><b>Mathematics — 90 minutes</b><div class="tiny">Concepts 25m · solved examples 20m · problem practice 40m · recap 5m</div></div><span class="pill">90 min</span></div>
<div class="scheduleblock"><b>10:15–10:30</b><div><b>Short break</b></div><span class="pill">15 min</span></div>
<div class="scheduleblock"><b>10:30–11:30</b><div><b>PYQs + revision — 60 minutes</b><div class="tiny">30m timed PYQs (alternate JEE / EAPCET) · 20m revise older topics · 10m plan tomorrow</div></div><span class="pill">60 min</span></div>
<div class="tiny">Total focused study = 6 hours. College: 9 AM–4 PM. Use the gaps for commute, snacks, rest and family time.</div></div>
<div class="panel"><div class="row"><h3>Today's chapter targets</h3><input id="planDate" type="date" style="max-width:170px" onchange="renderTargets()"></div><div id="dailyTargets"></div><div class="actions" style="margin-top:12px"><button class="primary" onclick="makeTodayTasks()">Add these targets to today's checklist</button><button onclick="go('syllabus')">Update chapter status</button></div></div>
<div class="panel"><h3>Weekly rhythm</h3><div class="entry"><b>Monday–Friday</b><div class="tiny">Follow the 6-hour block plan; complete new concepts and topic-wise questions.</div></div><div class="entry"><b>Saturday</b><div class="tiny">Finish pending chapters, practise mixed PYQs and revise the week's error log.</div></div><div class="entry"><b>Sunday</b><div class="tiny">One timed mock or part-test (up to 3 hours), then analyse mistakes and revise weak areas. If tired, use a shorter test.</div></div></div></section>
<section class="view" id="syllabus"><div class="heading"><div><h2>Complete syllabus tracker</h2><div class="sub">JEE Main 2027 official Paper 1 units + TG EAPCET 2026 Engineering reference.</div></div><span class="pill" id="chapterCount"></span></div><div class="notice">JEE Main 2027 list is taken from NTA's published Paper 1 syllabus. TG EAPCET 2027 syllabus has not been confirmed here; TG EAPCET 2026 is used as the latest available reference. Compare with the 2027 official notification when released.</div>
<div class="panel"><div class="grid three"><div class="field"><label>Exam</label><select id="examFilter" onchange="renderSyllabus()"><option>All exams</option><option>JEE Main 2027</option><option>TG EAPCET 2026 reference</option></select></div><div class="field"><label>Subject</label><select id="subjectFilter" onchange="renderSyllabus()"><option>All subjects</option><option>Physics</option><option>Chemistry</option><option>Mathematics</option></select></div><div class="field"><label>Search</label><input id="searchChapter" placeholder="Find a chapter..." oninput="renderSyllabus()"></div></div><div class="row"><span class="tiny" id="filteredCount"></span><select id="statusFilter" style="max-width:170px" onchange="renderSyllabus()"><option>All statuses</option><option>Not started</option><option>Learning</option><option>Practising</option><option>Revising</option><option>Completed</option></select></div><div id="chapterList"></div></div></section>
<section class="view" id="weekly"><div class="heading"><div><h2>Weekly progress</h2><div class="sub">See your study time and task completion across the last 7 days.</div></div></div><div class="grid stats"><div class="stat"><small>Hours logged</small><strong id="weekHours">0h</strong></div><div class="stat"><small>Study target</small><strong>42h</strong></div><div class="stat"><small>Chapters completed</small><strong id="weekChapters">0</strong></div><div class="stat"><small>Mock tests</small><strong id="weekMocks">0</strong></div></div><div class="panel"><h3>Daily study time</h3><div id="weekBars"></div></div><div class="panel"><h3>Weekly reflection</h3><div class="field"><label>What went well?</label><textarea id="reviewGood" rows="2"></textarea></div><div class="field"><label>What needs improvement?</label><textarea id="reviewImprove" rows="2"></textarea></div><button class="primary" onclick="saveReview()">Save reflection</button></div></section>
<section class="view" id="mocks"><div class="heading"><div><h2>Mock test tracker</h2><div class="sub">Record scores and the lesson from each test.</div></div></div><div class="panel"><h3>Add test result</h3><div class="grid three"><div class="field"><label>Exam</label><select id="mExam"><option>JEE Main</option><option>TG EAPCET</option></select></div><div class="field"><label>Date</label><input id="mDate" type="date"></div><div class="field"><label>Score</label><input id="mScore" type="number" min="0" placeholder="Score"></div></div><div class="grid three"><div class="field"><label>Maximum marks</label><input id="mMax" type="number" min="1" value="300"></div><div class="field"><label>Physics marks</label><input id="mP" type="number" min="0" placeholder="Optional"></div><div class="field"><label>Chemistry marks</label><input id="mC" type="number" min="0" placeholder="Optional"></div></div><div class="field"><label>Mathematics marks</label><input id="mM" type="number" min="0" placeholder="Optional"></div><div class="field"><label>What should you improve?</label><input id="mNote" placeholder="e.g. time management in calculus"></div><button class="primary" onclick="addMock()">Save result</button></div><div class="panel"><h3>Test history</h3><div class="tablewrap"><table><thead><tr><th>Date</th><th>Exam</th><th>Score</th><th>%</th><th>Focus</th><th></th></tr></thead><tbody id="mockRows"></tbody></table></div></div></section>
<section class="view" id="timer"><div class="heading"><div><h2>Focus timer</h2><div class="sub">Focus sessions automatically count toward your study hours.</div></div></div><div class="panel center"><div class="pill" id="timerMode">Focus session</div><div class="clock" id="clock">50:00</div><div class="tiny">Choose a session, start, and stay with one task.</div><div class="actions" style="justify-content:center;margin:15px"><button class="primary" id="timerBtn" onclick="toggleTimer()">Start focus</button><button onclick="resetTimer()">Reset</button><button onclick="switchMode('short')">5-minute break</button><button onclick="switchMode('long')">15-minute break</button></div><div class="grid three" style="max-width:600px;margin:auto"><div class="field"><label>Focus minutes</label><input id="focusMin" type="number" min="1" max="180" value="50"></div><div class="field"><label>Short break</label><input id="shortMin" type="number" min="1" max="60" value="5"></div><div class="field"><label>Long break</label><input id="longMin" type="number" min="1" max="90" value="15"></div></div></div></section>
<section class="view" id="revision"><div class="heading"><div><h2>Revision queue</h2><div class="sub">Space revision over time: next day, 3 days, 7 days and 14 days.</div></div></div><div class="panel"><h3>Add a revision</h3><div class="grid three"><div class="field"><label>Topic</label><input id="rTopic" placeholder="Chapter / subtopic"></div><div class="field"><label>Subject</label><select id="rSubject"><option>Physics</option><option>Chemistry</option><option>Mathematics</option></select></div><div class="field"><label>Due date</label><input id="rDate" type="date"></div></div><button class="primary" onclick="addRevision()">Add reminder</button><button onclick="addSpaced()">Create 1/3/7/14-day reminders from a topic</button></div><div class="panel"><h3>Upcoming reminders</h3><div id="revisionRows"></div></div></section>
<section class="view" id="tutor"><div class="heading"><div><h2>Study assistant</h2><div class="sub">Offline planning helper with a direct route to ChatGPT for detailed tutoring.</div></div></div><div class="notice">This app's built-in assistant is a simple offline helper, not a live AI model. A real AI tutor requires a secure backend; do not place secret API keys in a browser file.</div><div class="actions" style="margin-bottom:10px"><a href="https://chatgpt.com/" target="_blank" rel="noopener"><button class="primary">Open ChatGPT ↗</button></a><button onclick="copyPrompt()">Copy my tutor prompt</button></div><div class="panel"><div class="chatbox" id="chatbox"><div class="bubble bot">I can help you plan revision, analyse mock-test mistakes, and organise your preparation. For solving a specific question, open ChatGPT and share the question.</div></div><div class="chatrow"><input id="chatInput" placeholder="Ask about planning or revision..." onkeydown="if(event.key==='Enter')chat()"><button class="primary" onclick="chat()">Send</button></div></div></section>
<section class="view" id="resources"><div class="heading"><div><h2>Study resources</h2><div class="sub">Use a small, consistent set of resources.</div></div></div><div class="grid two"><div class="panel"><h3>Official syllabuses</h3><div class="entry"><b>JEE Main 2027 — NTA syllabus PDF</b><div class="tiny">Official Paper 1 syllabus published by NTA.</div><a href="https://jeemain.nta.nic.in/document/syllabus-2027/" target="_blank" rel="noopener">Open NTA syllabus ↗</a></div><div class="entry"><b>TG EAPCET official portal</b><div class="tiny">Check the official 2027 Engineering syllabus when announced; this app references the 2026 syllabus.</div><a href="https://eapcet.tgche.ac.in/" target="_blank" rel="noopener">Open TG EAPCET ↗</a></div></div><div class="panel"><h3>Free learning resources</h3><div class="entry"><b>SATHEE JEE</b><div class="tiny">Free lessons and practice material.</div><a href="https://sathee.iitk.ac.in/jee/" target="_blank" rel="noopener">Open SATHEE ↗</a></div><div class="entry"><b>NCERT textbooks</b><div class="tiny">Use Class 11 and 12 textbooks as a core reference.</div><a href="https://ncert.nic.in/textbook.php" target="_blank" rel="noopener">Open NCERT ↗</a></div></div><div class="panel"><h3>What to use for each chapter</h3><ol class="muted"><li>One concept lecture or textbook reading.</li><li>NCERT / Telangana Intermediate textbook examples.</li><li>One question bank for practice.</li><li>Topic-wise previous-year questions.</li><li>Error notebook and spaced revision.</li></ol></div><div class="panel"><h3>Daily study method</h3><ul class="muted"><li>Physics: understand the model, derive key equations, solve numerical problems.</li><li>Chemistry: NCERT facts, reactions, trends and calculation practice.</li><li>Mathematics: solve problems actively; record the method behind errors.</li><li>PYQs: practise timed sets after concept learning.</li></ul></div></div></section>

<section class="view" id="library">
 <div class="heading"><div><h2>Chapter study library</h2><div class="sub">Open a chapter to see its topic checklist and formula / equation sheet.</div></div><span class="pill green">Topic-by-topic</span></div>
 <div class="panel">
  <div class="library-controls">
   <div class="field"><label>Exam syllabus</label><select id="libExam" onchange="renderLibrary()"><option>All exams</option><option>JEE Main 2027</option><option>TG EAPCET 2026 reference</option></select></div>
   <div class="field"><label>Subject</label><select id="libSubject" onchange="renderLibrary()"><option>All subjects</option><option>Physics</option><option>Chemistry</option><option>Mathematics</option></select></div>
   <div class="field"><label>Find a chapter</label><input id="libSearch" placeholder="Search chapter or topic…" oninput="renderLibrary()"></div>
  </div>
  <div class="tiny" id="libCount"></div>
