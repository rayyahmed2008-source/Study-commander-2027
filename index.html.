let activeTest=null,testInterval=null;
function startPractice(){
 let exam=document.getElementById('testExam').value,sub=document.getElementById('testSubject').value,n=Number(document.getElementById('testCount').value),mins=Number(document.getElementById('testMinutes').value);
 let pool=questionBank.filter(q=>sub==='all'||q.subject===sub);
 if(exam==='jee'||exam==='eamcet'){} // Both exam modes draw from the PCM question bank.
 pool=pool.slice().sort(()=>Math.random()-.5);
 if(pool.length<n){let expanded=[];while(expanded.length<n)expanded.push(...pool);pool=expanded.slice(0,n)}else pool=pool.slice(0,n);
 activeTest={exam,questions:pool,answers:{},index:0,seconds:mins*60,submitted:false};
 document.getElementById('testSetup').style.display='none';document.getElementById('testResult').style.display='none';document.getElementById('testArea').style.display='block';
 document.getElementById('testLabel').textContent=exam==='jee'?'JEE Main style':exam==='eamcet'?'TG EAPCET style':'Mixed PCM';
 renderQuestion();drawTestClock();if(testInterval)clearInterval(testInterval);testInterval=setInterval(()=>{if(!activeTest||activeTest.submitted)return;activeTest.seconds--;drawTestClock();if(activeTest.seconds<=0)submitPractice(true)},1000);
}
function drawTestClock(){let s=activeTest?.seconds||0;document.getElementById('testClock').textContent=String(Math.floor(s/60)).padStart(2,'0')+':'+String(s%60).padStart(2,'0')}
function renderQuestion(){
 let t=activeTest,q=t.questions[t.index],picked=t.answers[t.index];
 document.getElementById('testProgress').textContent=`Question ${t.index+1} of ${t.questions.length} · ${q.subject}`;
 document.getElementById('testBar').style.width=((t.index+1)/t.questions.length*100)+'%';
 document.getElementById('questionArea').innerHTML=`<div class="tiny" style="margin-top:15px">${esc(q.chapter)}</div><h3 style="font-size:18px;line-height:1.5;margin:8px 0 15px">${esc(q.q)}</h3>${q.o.map((o,i)=>`<label class="q-option ${picked===i?'selected':''}"><input type="radio" name="answer" ${picked===i?'checked':''} onchange="chooseAnswer(${i})"><span><b>${String.fromCharCode(65+i)}.</b> ${esc(o)}</span></label>`).join('')}`;
}
function chooseAnswer(i){activeTest.answers[activeTest.index]=i;renderQuestion()}
function moveQuestion(d){activeTest.index=Math.max(0,Math.min(activeTest.questions.length-1,activeTest.index+d));renderQuestion()}
function submitPractice(auto=false){
 if(!activeTest||activeTest.submitted)return;activeTest.submitted=true;if(testInterval)clearInterval(testInterval);
 let correct=0,wrong=0,skip=0,jee=activeTest.exam==='jee';
 activeTest.questions.forEach((q,i)=>{let a=activeTest.answers[i];if(a===undefined)skip++;else if(a===q.a)correct++;else wrong++});
 let score=jee?correct*4-wrong:correct,maximum=jee?activeTest.questions.length*4:activeTest.questions.length;
 let html=`<div class="row"><h3>Test result ${auto?'· Time ended':''}</h3><span class="pill green">${Math.round(score/maximum*100)}%</span></div><div class="grid three"><div class="stat"><small>Score</small><strong>${score}/${maximum}</strong></div><div class="stat"><small>Correct</small><strong>${correct}</strong></div><div class="stat"><small>Incorrect / skipped</small><strong>${wrong} / ${skip}</strong></div></div><h3 style="margin-top:15px">Answer review</h3>`;
 activeTest.questions.forEach((q,i)=>{let a=activeTest.answers[i],ok=a===q.a;html+=`<div class="answer-review"><b>${i+1}. ${esc(q.q)}</b><div class="tiny">${ok?'Correct':a===undefined?'Not attempted':'Incorrect'} · Correct answer: ${String.fromCharCode(65+q.a)}. ${esc(q.o[q.a])}</div><div class="tiny">${esc(q.e)}</div></div>`});
 html+=`<div class="actions" style="margin-top:12px"><button class="primary" onclick="newPractice()">Build another test</button><button onclick="savePracticeResult(${score},${maximum})">Save score to mock tracker</button></div>`;
 document.getElementById('testResult').innerHTML=html;document.getElementById('testResult').style.display='block';document.getElementById('testArea').style.display='none';
}
function newPractice(){activeTest=null;document.getElementById('testSetup').style.display='block';document.getElementById('testArea').style.display='none';document.getElementById('testResult').style.display='none'}
function savePracticeResult(score,max){data.mocks.push({id:Date.now(),exam:activeTest.exam==='jee'?'JEE Main practice':activeTest.exam==='eamcet'?'TG EAPCET practice':'Mixed PCM practice',date:dateKey(),score,max,note:'Built-in practice test'});save();alert('Practice score saved to Mock Test Tracker.')}
const oldGo=go;
go=function(id){oldGo(id);if(id==='library')renderLibrary();};
const oldRenderAll=renderAll;
renderAll=function(){oldRenderAll();};

