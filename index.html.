document.getElementById('chapterTargets').innerHTML=currentTargets().map(t=>`<div class="entry"><span class="pill">${t.exam}</span> <span class="pill">${t.subject}</span> &nbsp; <b>${esc(t.chapter)}</b></div>`).join('');
