function renderSyllabus(){let ex=document.getElementById('examFilter').value,s=document.getElementById('subjectFilter').value,q=document.getElementById('searchChapter').value.toLowerCase(),st=document.getElementById('statusFilter').value;let arr=data.chapters.filter(c=>(ex==='All exams'||c.exam===ex)&&(s==='All subjects'||c.subject===s)&&c.name.toLowerCase().includes(q)&&(st==='All statuses'||c.status===st));document.getElementById('chapterCount').textContent=data.chapters.length+' entries';document.getElementById('filteredCount').textContent=arr.length+' matching entries';document.getElementById('chapterList').innerHTML=arr.map(c=>`<div class="chapter"><div class="row"><div style="min-width:0"><b>${esc(c.name)}</b><div class="tiny">${c.subject} · ${c.exam}</div></div><select style="max-width:145px" onchange="setStatus(${c.id},this.value)">${['Not started','Learning','Practising','Revising','Completed'].map(x=>`<option ${c.status===x?'selected':''}>${x}</option>`).join('')}</select></div></div>`).join('')||'<div class="empty">No matching chapters.</div>'}
function setStatus(id,v){data.chapters.find(c=>c.id===id).status=v;save()}
function toggleTask(i){data.tasks[i].done=!data.tasks[i].done;save()}
function renderWeekly(){let days=[];for(let i=6;i>=0;i--){let d=new Date();d.setDate(d.getDate()-i);days.push({key:dateKey(d),label:d.toLocaleDateString(undefined,{weekday:'short'})})}let total=days.reduce((a,x)=>a+(data.sessions[x.key]||0),0);document.getElementById('weekHours').textContent=(total/60).toFixed(1)+'h';document.getElementById('weekChapters').textContent=data.chapters.filter(c=>c.status==='Completed').length;document.getElementById('weekMocks').textContent=data.mocks.filter(m=>m.date>=days[0].key).length;document.getElementById('weekBars').innerHTML=days.map(x=>{let m=data.sessions[x.key]||0;return `<div style="margin:12px 0"><div class="row"><span>${x.label}</span><span class="tiny">${(m/60).toFixed(1)}h</span></div><div class="bar"><span style="width:${Math.min(100,m/(data.settings.target*60)*100)}%"></span></div></div>`}).join('');document.getElementById('reviewGood').value=data.notes.good||'';document.getElementById('reviewImprove').value=data.notes.improve||''}
function saveReview(){data.notes.good=document.getElementById('reviewGood').value;data.notes.improve=document.getElementById('reviewImprove').value;save();alert('Reflection saved.')}
function addMock(){let score=Number(document.getElementById('mScore').value),max=Number(document.getElementById('mMax').value);if(!max||score<0||score>max){alert('Enter a valid score and maximum.');return}data.mocks.push({id:Date.now(),exam:document.getElementById('mExam').value,date:document.getElementById('mDate').value||dateKey(),score,max,p:document.getElementById('mP').value,c:document.getElementById('mC').value,m:document.getElementById('mM').value,note:document.getElementById('mNote').value});save();['mScore','mP','mC','mM','mNote'].forEach(x=>document.getElementById(x).value='')}
